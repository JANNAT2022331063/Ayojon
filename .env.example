# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# SMS Provider Selection
# Uncomment and configure ONE of the following SMS providers:

# Option 1: Twilio (International)
# TWILIO_ACCOUNT_SID=your_account_sid_here
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# Option 2: SSL Wireless (Bangladesh)
# SSL_API_TOKEN=your_api_token_here
# SSL_SID=your_sender_id_here
# SSL_API_URL=https://smsplus.sslwireless.com/api/v3/send-sms

# Option 3: Other HTTP-based SMS API
# SMS_API_URL=https://api.example.com/send
# SMS_API_KEY=your_api_key_here
# SMS_API_SECRET=your_api_secret_here
# SMS_SENDER_ID=YourBrand

# Database Configuration (if needed in future)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=ayojon_db

# Admin Security
ADMIN_SIGNUP_KEY=ayojon_admin_2026
